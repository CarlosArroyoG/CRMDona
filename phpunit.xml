<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Condiciones de carrera con procesos reales contra PostgreSQL. Van al final. -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="crm_testing" force="true"/>
        <server name="DB_DATABASE" value="crm_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <!-- Pagos: solo la pasarela simulada. Las pruebas nunca llaman a Stripe ni a Mercado Pago. -->
        <env name="PAYMENTS_FAKE_ENABLED" value="true" force="true"/>
        <server name="PAYMENTS_FAKE_ENABLED" value="true" force="true"/>
        <env name="PAYMENTS_FAKE_STORE" value="array" force="true"/>
        <server name="PAYMENTS_FAKE_STORE" value="array" force="true"/>
        <!-- CFDI: solo el PAC simulado en pruebas. -->
        <env name="CFDI_PROVIDER" value="fake" force="true"/>
        <server name="CFDI_PROVIDER" value="fake" force="true"/>
        <env name="CFDI_AUTO_ISSUE" value="false" force="true"/>
        <server name="CFDI_AUTO_ISSUE" value="false" force="true"/>
        <env name="CFDI_FAKE_STORE" value="array" force="true"/>
        <server name="CFDI_FAKE_STORE" value="array" force="true"/>
        <env name="FACTURAPI_KEY" value="" force="true"/>
        <server name="FACTURAPI_KEY" value="" force="true"/>
        <env name="STRIPE_ENABLED" value="false" force="true"/>
        <server name="STRIPE_ENABLED" value="false" force="true"/>
        <env name="STRIPE_SECRET_KEY" value="" force="true"/>
        <server name="STRIPE_SECRET_KEY" value="" force="true"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="" force="true"/>
        <server name="STRIPE_WEBHOOK_SECRET" value="" force="true"/>
        <env name="MERCADO_PAGO_ENABLED" value="false" force="true"/>
        <server name="MERCADO_PAGO_ENABLED" value="false" force="true"/>
        <env name="MERCADO_PAGO_ACCESS_TOKEN" value="" force="true"/>
        <server name="MERCADO_PAGO_ACCESS_TOKEN" value="" force="true"/>
        <env name="MERCADO_PAGO_WEBHOOK_SECRET" value="" force="true"/>
        <server name="MERCADO_PAGO_WEBHOOK_SECRET" value="" force="true"/>
    </php>
</phpunit>
